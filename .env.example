# Copy to .env and fill in: cp .env.example .env

# Go API for `npm run dev` (Vite proxies /api here)
API_TARGET=http://localhost:8080

# Go API as the frontend container sees it (API container name on the Docker network).
# Required for Docker, e.g. http://my-api:8080
DOCKER_API_TARGET=

# Port for the frontend container
WEB_PORT=3000

# Docker network the API container runs on (make up joins it).
# Required for Docker: find it with `docker network ls`
API_NETWORK=
